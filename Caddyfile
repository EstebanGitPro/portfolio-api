# Reverse proxy and TLS terminator. Caddy requests and renews the certificate from
# Let's Encrypt on its own, so nothing here needs certbot or a cron job.

{$API_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format console
	}

	# The application has no authentication of its own: anyone who can reach
	# /api/admin/* can create and delete projects. HTTP Basic at the edge is what
	# stands between those endpoints and the internet, so it also covers the API
	# docs, which are a map of that same surface.
	@protected path /api/admin/* /swagger-ui/* /v3/api-docs*
	basic_auth @protected {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}

	# The actuator is for the host, not for visitors.
	@actuator path /actuator/*
	respond @actuator 404

	reverse_proxy portfolio-api:8086 {
		health_uri /actuator/health
		health_interval 30s
		health_timeout 5s
	}
}
